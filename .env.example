# ローカル開発用の設定例。本番・Preview の値は Vercel / GitHub に設定する（docs/deployment.md）。

# ---- Database ----
# 開発用 DB（docker compose up -d で起動）
DATABASE_URL="postgresql://projectflow:projectflow@localhost:5433/projectflow"
# 統合テスト・E2E テスト用 DB（テスト実行時に毎回データを削除する）
TEST_DATABASE_URL="postgresql://projectflow:projectflow@localhost:5433/projectflow_test"
# Prisma CLI（migrate など）用の Direct Connection。ローカルでは不要（DATABASE_URL が localhost なら代わりに使う）。
# リモートの DB（Neon）へのマイグレーションは DIRECT_URL を設定した場合のみ実行できる
# DIRECT_URL=""

# ---- Better Auth ----
# 32 文字以上のランダム文字列。生成例: openssl rand -base64 32
BETTER_AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Mail (本番のみ必須) ----
# 未設定の場合、開発環境ではリセット URL をコンソールに出力する
RESEND_API_KEY=""
MAIL_FROM="ProjectFlow <noreply@example.com>"

# ---- Vercel でのみ使用（ローカルでは設定しない） ----
# PRODUCTION_DB_ENDPOINT_ID   本番ブランチの Neon エンドポイント ID（Preview から本番 DB への接続を拒否するため）
# PREVIEW_MAIL_ALLOWED_RECIPIENTS  Preview でメールを送ってよい宛先（カンマ区切り）
